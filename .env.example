# Public client config
# Controls which provider labels the frontend should expect.
NEXT_PUBLIC_AI_PROVIDER_MODE=mock
NEXT_PUBLIC_AI_TEXT_PROVIDER=dashscope
NEXT_PUBLIC_AI_IMAGE_PROVIDER=dashscope
NEXT_PUBLIC_CLOUDBASE_ENV_ID=

# Server config
# Use real when the server should call DashScope.
AI_PROVIDER_MODE=mock
AI_TEXT_PROVIDER=dashscope
AI_IMAGE_PROVIDER=dashscope
AI_ALLOW_MOCK_FALLBACK=true

# CloudBase server config
# In CloudBase runtime these can stay empty and use the current environment automatically.
CLOUDBASE_ENV_ID=
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
CLOUDBASE_SESSION_TOKEN=
CLOUDBASE_USE_RUNTIME_ENV=true

# DashScope text
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=qwen-plus

# DashScope image
DASHSCOPE_IMAGE_GENERATION_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/image-generation/generation
DASHSCOPE_IMAGE_MODEL=wan2.7-image

# Server-side image polling budget
# Increase these if CloudBase image jobs are still timing out.
DASHSCOPE_IMAGE_POLL_MAX_ATTEMPTS=48
DASHSCOPE_IMAGE_POLL_INITIAL_DELAY_MS=2500
DASHSCOPE_IMAGE_POLL_INTERVAL_MS=3000
